    {
      "screen_id": "SCR-01",
      "name": "GitHub PAT 로그인",
      "data_api": "GitHubRepository.login(token)",
      "why": "GitHub Personal Access Token으로 인증하여 내 저장소와 star/watch 저장소의 릴리즈를 확인할 수 있게 함",
      "source_files": [
        "app/src/main/java/com/releasewatch/app/ui/login/LoginScreen.kt",
        "app/src/main/java/com/releasewatch/app/ui/login/LoginViewModel.kt"
      ],
      "id": "FN-01",
